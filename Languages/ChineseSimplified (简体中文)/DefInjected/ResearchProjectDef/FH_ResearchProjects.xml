  <FH_Research_EfficientCellDivision.label>高效细胞分裂</FH_Research_EfficientCellDivision.label>
  <!-- EN: Increases fleshbeast production speed by 50%. -->
  <FH_Research_EfficientCellDivision.description>血肉兽生产速度提高50%。</FH_Research_EfficientCellDivision.description>
  <FH_Research_EfficientCellDivision.customUnlockTexts.0>血肉兽生产速度提高50%</FH_Research_EfficientCellDivision.customUnlockTexts.0>
  
  <!-- EN: efficient flesh expansion -->
  <FH_Research_EfficientFleshExpansion.label>高效血肉扩张</FH_Research_EfficientFleshExpansion.label>
  <!-- EN: Increases global flesh terrain spread speed by 50%. -->
  <FH_Research_EfficientFleshExpansion.description>全局血肉地形扩张速度提高50%。</FH_Research_EfficientFleshExpansion.description>
