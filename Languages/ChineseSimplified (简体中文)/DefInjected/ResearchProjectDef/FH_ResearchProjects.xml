  <!-- EN: chitin-plated flesh blocks -->
  <FH_Research_BonePlatingFleshBlock.label>甲壳血肉块</FH_Research_BonePlatingFleshBlock.label>
  <!-- EN: Unlocks chitin-plated flesh blocks and chitin-plated flesh barricades. -->
  <FH_Research_BonePlatingFleshBlock.description>解锁甲壳血肉块和甲壳血肉掩体。</FH_Research_BonePlatingFleshBlock.description>
