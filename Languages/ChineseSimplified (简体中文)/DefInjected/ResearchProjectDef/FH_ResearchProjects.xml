<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <FH_Research_BasicFleshHive.label>基础血肉巢穴</FH_Research_BasicFleshHive.label>
  <FH_Research_BasicFleshHive.description>解锁血肉巢穴、血肉地板、血肉块、血肉门、血肉囊泡、血肉产出口、扭曲肉生产，以及小型血肉兽培育。</FH_Research_BasicFleshHive.description>
  <FH_Research_BasicFleshHive.customUnlockTexts.0>扭曲肉</FH_Research_BasicFleshHive.customUnlockTexts.0>
  <FH_Research_BasicFleshHive.customUnlockTexts.1>小型血肉兽</FH_Research_BasicFleshHive.customUnlockTexts.1>

  <FH_Research_NutritionCycle.label>营养循环</FH_Research_NutritionCycle.label>
  <FH_Research_NutritionCycle.description>解锁血肉灯、肉果丛、血肉囊和血肉发电机的生产。</FH_Research_NutritionCycle.description>

  <FH_Research_ImmuneSystem.label>免疫系统</FH_Research_ImmuneSystem.label>
  <FH_Research_ImmuneSystem.description>解锁骨刺喷吐器、小型警卫触手和血肉掩体。</FH_Research_ImmuneSystem.description>

  <FH_Research_FleshFurniture.label>血肉家具</FH_Research_FleshFurniture.label>
  <FH_Research_FleshFurniture.description>解锁血肉床、血肉桌子、血肉凳子和血肉支撑柱。</FH_Research_FleshFurniture.description>

  <FH_Research_FleshbeastCoexistence.label>血肉兽共存</FH_Research_FleshbeastCoexistence.label>
  <FH_Research_FleshbeastCoexistence.description>解锁血肉寄生仓，并允许生产血肉适应模块和血肉共生模块。</FH_Research_FleshbeastCoexistence.description>

  <FH_Research_ComplexFleshHive.label>复杂血肉巢穴</FH_Research_ComplexFleshHive.label>
  <FH_Research_ComplexFleshHive.description>解锁巢群神经结节、血肉巢群升级、中型血肉兽培育、活铁和神经块生产。培育单位仍需先发现对应融合配方。</FH_Research_ComplexFleshHive.description>
  <FH_Research_ComplexFleshHive.customUnlockTexts.0>中型血肉兽</FH_Research_ComplexFleshHive.customUnlockTexts.0>
  <FH_Research_ComplexFleshHive.customUnlockTexts.1>活铁</FH_Research_ComplexFleshHive.customUnlockTexts.1>
  <FH_Research_ComplexFleshHive.customUnlockTexts.2>血肉巢群升级</FH_Research_ComplexFleshHive.customUnlockTexts.2>

  <FH_Research_FleshFusion.label>血肉融合</FH_Research_FleshFusion.label>
  <FH_Research_FleshFusion.description>允许中型血肉兽融合，并解锁血肉触手、血肉触鞭、血肉胃和血肉肺的生产。</FH_Research_FleshFusion.description>
  <FH_Research_FleshFusion.customUnlockTexts.0>中型血肉兽融合</FH_Research_FleshFusion.customUnlockTexts.0>

  <FH_Research_FleshReplica.label>血肉拟像</FH_Research_FleshReplica.label>
  <FH_Research_FleshReplica.description>允许培育血肉拟像。</FH_Research_FleshReplica.description>
  <FH_Research_FleshReplica.customUnlockTexts.0>血肉拟像培育</FH_Research_FleshReplica.customUnlockTexts.0>

  <FH_Research_BonePlatingFleshBlock.label>甲壳血肉块</FH_Research_BonePlatingFleshBlock.label>
  <FH_Research_BonePlatingFleshBlock.description>研究后，将地图中的血肉块和血肉掩体替换为甲壳版本，并解锁甲壳血肉块和甲壳血肉掩体。</FH_Research_BonePlatingFleshBlock.description>
  <FH_Research_BonePlatingFleshBlock.customUnlockTexts.0>硬化所有血肉块和掩体</FH_Research_BonePlatingFleshBlock.customUnlockTexts.0>

  <FH_Research_ComplexImmuneSystem.label>复杂免疫系统</FH_Research_ComplexImmuneSystem.label>
  <FH_Research_ComplexImmuneSystem.description>解锁血肉喷吐器、血肉爆炸器和警卫触手中枢。</FH_Research_ComplexImmuneSystem.description>

  <FH_Research_FleshPrimaryHive.label>高级血肉巢穴</FH_Research_FleshPrimaryHive.label>
  <FH_Research_FleshPrimaryHive.description>解锁巢群神经中枢、大型血肉兽培育，以及血肉巢穴进化为血肉主巢。</FH_Research_FleshPrimaryHive.description>
  <FH_Research_FleshPrimaryHive.customUnlockTexts.0>大型血肉兽</FH_Research_FleshPrimaryHive.customUnlockTexts.0>
  <FH_Research_FleshPrimaryHive.customUnlockTexts.1>血肉主巢进化</FH_Research_FleshPrimaryHive.customUnlockTexts.1>

  <FH_Research_ComplexFleshFusion.label>复杂血肉融合</FH_Research_ComplexFleshFusion.label>
  <FH_Research_ComplexFleshFusion.description>允许大型血肉兽融合，并解锁寄生扩容背包的生产。</FH_Research_ComplexFleshFusion.description>
  <FH_Research_ComplexFleshFusion.customUnlockTexts.0>大型血肉兽融合</FH_Research_ComplexFleshFusion.customUnlockTexts.0>

  <FH_Research_MotherBeastControl.label>血肉母兽控制</FH_Research_MotherBeastControl.label>
  <FH_Research_MotherBeastControl.description>允许培育血肉母兽。</FH_Research_MotherBeastControl.description>
  <FH_Research_MotherBeastControl.customUnlockTexts.0>血肉母兽培育</FH_Research_MotherBeastControl.customUnlockTexts.0>

