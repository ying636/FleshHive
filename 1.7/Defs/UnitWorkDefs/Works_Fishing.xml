<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <HiveCreatureFramework.UnitWorkDef MayRequire="Ludeon.RimWorld.Odyssey">
        <defName>FH_UnitWork_FingerspikeAnimalFishing</defName>
        <label>Animal fishing</label>
        <description>Fish using Odyssey's animal fishing behavior</description>
        <thinkTree>FH_ThinkTree_UnitWork_FingerspikeAnimalFishing</thinkTree>
    </HiveCreatureFramework.UnitWorkDef>

    <ThinkTreeDef MayRequire="Ludeon.RimWorld.Odyssey">
        <defName>FH_ThinkTree_UnitWork_FingerspikeAnimalFishing</defName>
        <thinkRoot Class="ThinkNode_Priority">
            <subNodes>
                <li Class="FleshHive.JobGiver_FingerspikeAnimalFishing" />
            </subNodes>
        </thinkRoot>
    </ThinkTreeDef>

    <JobDef MayRequire="Ludeon.RimWorld.Odyssey">
        <defName>FH_FishAnimal</defName>
        <driverClass>FleshHive.JobDriver_FingerspikeAnimalFishing</driverClass>
        <reportString>fishing.</reportString>
        <suspendable>false</suspendable>
        <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
    </JobDef>

</Defs>
