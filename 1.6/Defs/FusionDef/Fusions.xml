<Defs>

  <HiveCreatureFramework.FusionDef>
    <defName>FH_Fusion_Toughspike_Fingerspike_Fingerspike</defName>
    <label>toughspike fusion</label>
    <description>Fuse two fingerspikes into a toughspike.</description>
    <category>LittleFlesh</category>
    <progressTick>30000</progressTick>
    <hiden>true</hiden>
    <materials>
      <li Class="HiveCreatureFramework.FusionMaterial_Def">
        <def>FH_Fingerspike</def>
      </li>
      <li Class="HiveCreatureFramework.FusionMaterial_Def">
        <def>FH_Fingerspike</def>
      </li>
    </materials>
    <results>
      <li>
        <result Class="HiveCreatureFramework.FusionResult_PawnKind">
          <label>toughspike</label>
          <description>A stable toughspike with no special trait.</description>
          <kind>FH_Toughspike</kind>
        </result>
        <weight>1</weight>
      </li>
    </results>
  </HiveCreatureFramework.FusionDef>

