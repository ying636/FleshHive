    <knowledgeCost>20</knowledgeCost>
    <knowledgeCategory>Basic</knowledgeCategory>
    <techLevel>Industrial</techLevel>
    <customUnlockTexts>
      <li>Whipspike cultivation</li>
      <li>Medium fleshbeast fusion</li>
      <li>Flesh sacks</li>
      <li>Flesh barricades</li>
      <li>Flesh recycler pools</li>
      <li>Flesh primary nests</li>
      <li>Bone-spike spitters</li>
      <li>Nerve bundles</li>
    </customUnlockTexts>
    <prerequisites>
      <li>FH_Research_BasicFleshHive</li>
    </prerequisites>
    <researchViewX>4</researchViewX>
    <researchViewY>2</researchViewY>
    <tab>FH_ResearchTab_FleshHive</tab>
