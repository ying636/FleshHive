    <knowledgeCost>15</knowledgeCost>
    <knowledgeCategory>Basic</knowledgeCategory>
    <techLevel>Industrial</techLevel>
    <customUnlockTexts><li>Flesh replica cultivation</li></customUnlockTexts>
