<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ResearchProjectDef>
    <defName>FH_Research_BasicFleshHive</defName>
    <label>basic flesh hive</label>
    <description>Unlocks the basic flesh hive, flesh floors, flesh blocks, flesh doors, flesh vesicles, flesh hoppers, twisted meat production, and cultivation of all small fleshbeasts.</description>
    <knowledgeCost>5</knowledgeCost>
    <knowledgeCategory>Basic</knowledgeCategory>
    <techLevel>Industrial</techLevel>
    <customUnlockTexts>
      <li>Twisted meat</li>
      <li>All small fleshbeasts</li>
    </customUnlockTexts>
    <researchViewX>0</researchViewX>
    <researchViewY>2.5</researchViewY>
    <tab>FH_ResearchTab_FleshHive</tab>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>FH_Research_NutritionCycle</defName>
    <label>nutrition cycle</label>
    <description>Unlocks production of flesh lamps, fleshberry bushes, flesh sacks, and flesh power generators.</description>
    <knowledgeCost>5</knowledgeCost>
    <knowledgeCategory>Basic</knowledgeCategory>
    <techLevel>Industrial</techLevel>
    <prerequisites><li>FH_Research_BasicFleshHive</li></prerequisites>
    <researchViewX>1.50</researchViewX>
    <researchViewY>0.00</researchViewY>
    <tab>FH_ResearchTab_FleshHive</tab>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>FH_Research_ImmuneSystem</defName>
    <label>immune system</label>
    <description>Unlocks bone-spike spitters, small guard tentacles, and flesh barricades.</description>
    <knowledgeCost>10</knowledgeCost>
    <knowledgeCategory>Basic</knowledgeCategory>
    <techLevel>Industrial</techLevel>
    <prerequisites><li>FH_Research_BasicFleshHive</li></prerequisites>
    <researchViewX>1.50</researchViewX>
    <researchViewY>1.30</researchViewY>
    <tab>FH_ResearchTab_FleshHive</tab>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>FH_Research_FleshFurniture</defName>
    <label>flesh furniture</label>
    <description>Unlocks flesh beds, tables, stools, and support columns.</description>
    <knowledgeCost>5</knowledgeCost>
    <knowledgeCategory>Basic</knowledgeCategory>
    <techLevel>Industrial</techLevel>
    <prerequisites><li>FH_Research_BasicFleshHive</li></prerequisites>
    <researchViewX>1.50</researchViewX>
    <researchViewY>4.90</researchViewY>
