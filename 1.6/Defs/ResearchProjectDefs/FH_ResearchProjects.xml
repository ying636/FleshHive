  <ResearchProjectDef>
    <defName>FH_Research_FleshbeastCoexistence</defName>
    <label>fleshbeast coexistence</label>
    <description>Unlocks flesh parasite vats and production of flesh adaptation modules and flesh symbiosis modules.</description>
    <knowledgeCost>20</knowledgeCost>
    <knowledgeCategory>Basic</knowledgeCategory>
    <techLevel>Industrial</techLevel>
    <prerequisites><li>FH_Research_BasicFleshHive</li></prerequisites>
    <researchViewX>1.50</researchViewX>
    <researchViewY>3.80</researchViewY>
    <tab>FH_ResearchTab_FleshHive</tab>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>FH_Research_ComplexFleshHive</defName>
    <label>complex flesh hive</label>
    <description>Unlocks nerve bundles, flesh hive upgrades, cultivation of all discovered medium fleshbeast formulas except flesh replicas, and production of bioferrite and nerve flesh.</description>
    <knowledgeCost>20</knowledgeCost>
    <knowledgeCategory>Basic</knowledgeCategory>
    <techLevel>Industrial</techLevel>
    <customUnlockTexts>
      <li>All medium fleshbeasts except flesh replicas</li>
      <li>Bioferrite</li>
      <li>Flesh hive upgrades</li>
    </customUnlockTexts>
    <prerequisites><li>FH_Research_BasicFleshHive</li></prerequisites>
    <researchViewX>1.50</researchViewX>
    <researchViewY>2.50</researchViewY>
    <tab>FH_ResearchTab_FleshHive</tab>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>FH_Research_FleshFusion</defName>
    <label>flesh fusion</label>
    <description>Allows medium fleshbeast fusion and unlocks production of flesh tentacles, flesh whips, fleshmass stomachs, and fleshmass lungs.</description>
    <knowledgeCost>10</knowledgeCost>
    <knowledgeCategory>Basic</knowledgeCategory>
    <techLevel>Industrial</techLevel>
    <customUnlockTexts>
      <li>Medium fleshbeast fusion</li>
