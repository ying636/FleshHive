    <prerequisites><li>FH_Research_ComplexFleshHive</li></prerequisites>
    <researchViewX>3.00</researchViewX>
    <researchViewY>0.00</researchViewY>
    <tab>FH_ResearchTab_FleshHive</tab>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>FH_Research_FleshReplica</defName>
