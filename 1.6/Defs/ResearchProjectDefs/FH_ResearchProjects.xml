<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ResearchProjectDef>
    <defName>FH_Research_BasicFleshHive</defName>
    <label>basic flesh hive</label>
    <description>Unlocks basic flesh hive cultivation, basic fleshbeasts, flesh hoppers, flesh trees, flesh doors, flesh blocks, flesh lamps, and efficient flesh expansion research.</description>
    <knowledgeCost>5</knowledgeCost>
    <knowledgeCategory>Basic</knowledgeCategory>
    <techLevel>Industrial</techLevel>
    <customUnlockTexts>
      <li>Basic fleshbeast gestation</li>
      <li>Flesh hoppers</li>
      <li>Flesh trees</li>
      <li>Flesh doors</li>
      <li>Flesh blocks</li>
      <li>Flesh lamps</li>
      <li>Efficient flesh expansion research</li>
    </customUnlockTexts>
    <researchViewX>0</researchViewX>
    <researchViewY>2</researchViewY>
    <tab>FH_ResearchTab_FleshHive</tab>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>FH_Research_FleshbeastCoexistence</defName>
    <label>fleshbeast coexistence</label>
    <description>Unlocks flesh parasite vats, flesh tendrils, flesh whips, fleshmass lungs, fleshmass stomachs, and flesh adaptation modules.</description>
    <knowledgeCost>20</knowledgeCost>
    <knowledgeCategory>Basic</knowledgeCategory>
    <techLevel>Industrial</techLevel>
    <customUnlockTexts>
      <li>Flesh parasite vats</li>
      <li>Flesh tendrils</li>
      <li>Flesh whips</li>
      <li>Fleshmass lungs</li>
      <li>Fleshmass stomachs</li>
      <li>Flesh adaptation modules</li>
    </customUnlockTexts>
    <prerequisites>
      <li>FH_Research_BasicFleshHive</li>
    </prerequisites>
    <researchViewX>2</researchViewX>
    <researchViewY>1</researchViewY>
    <tab>FH_ResearchTab_FleshHive</tab>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>FH_Research_EfficientFleshExpansion</defName>
    <label>efficient flesh expansion</label>
    <description>Increases global flesh terrain spread speed by 50%.</description>
    <knowledgeCost>10</knowledgeCost>
    <knowledgeCategory>Basic</knowledgeCategory>
    <techLevel>Industrial</techLevel>
    <customUnlockTexts>
      <li>Global flesh terrain spread speed +50%</li>
    </customUnlockTexts>
