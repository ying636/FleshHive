<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <PsychicRitualDef Class="FleshHive.PsychicRitualDef_SummonGiantFleshbeast">
    <defName>FH_SummonNexusmeld</defName>
    <label>draw nexusmeld</label>
    <description>Create a psychic pulse which will draw a nexusmeld to dig upwards and emerge near your enemies. Lower-quality rituals are less precise and will attract more fleshbeast escorts.</description>
    <researchPrerequisite>SummonFleshbeastsPlayer</researchPrerequisite>
    <outcomeDescription>A higher-quality ritual will attract fewer fleshbeast escorts.</outcomeDescription>
    <hoursUntilOutcome>2</hoursUntilOutcome>
    <castableOnPocketMaps>false</castableOnPocketMaps>
    <layerWhitelist>
      <li>Surface</li>
    </layerWhitelist>
    <requiredOffering>
      <filter>
        <thingDefs>
          <li>Shard</li>
        </thingDefs>
      </filter>
      <count>1</count>
    </requiredOffering>
    <cooldownHours>240</cooldownHours>
    <chanterRole>ChanterAdvanced</chanterRole>
    <summonKind>FH_Nexusmeld</summonKind>
    <escortPointsFromQualityCurve>
      <points>
        <li>(0, 650)</li>
        <li>(0.7, 350)</li>
        <li>(1, 150)</li>
      </points>
    </escortPointsFromQualityCurve>
    <iconPath>Things/Pawn/Fleshbeast/FH_Nexusmeld/FH_Nexusmeld</iconPath>
  </PsychicRitualDef>

