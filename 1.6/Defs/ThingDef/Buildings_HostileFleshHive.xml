<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingNaturalBase" MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>FH_HostileFleshHive</defName>
    <label>FH_HostileFleshHive</label>
    <description>FH_HostileFleshHive</description>
    <thingClass>FleshHive.Building_HostileFleshHive</thingClass>
    <graphicData>
      <texPath>Things/Building/FH_FleshHive/FH_FleshHive</texPath>
      <graphicClass>FleshHive.Graphic_Single_SquashNStretchSafe</graphicClass>
      <drawSize>(3.5,3.5)</drawSize>
      <drawOffset>(0,0,0.6)</drawOffset>
      <shaderType>BuildingSquashNStretch</shaderType>
      <maxSnS>(.9, .95)</maxSnS>
      <offsetSnS>(.5, -.45)</offsetSnS>
    </graphicData>
    <size>(3,2)</size>
    <uiIconScale>0.65</uiIconScale>
    <specialDisplayRadius>10.5</specialDisplayRadius>
    <altitudeLayer>Building</altitudeLayer>
    <drawerType>RealtimeOnly</drawerType>
    <rotatable>false</rotatable>
    <fillPercent>0.5</fillPercent>
    <statBases>
      <MaxHitPoints>1300</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <HCF_Stat_HiveCapacity>36</HCF_Stat_HiveCapacity>
    </statBases>
    <pathCost>42</pathCost>
    <receivesSignals>true</receivesSignals>
    <blockWind>true</blockWind>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <comps>
      <li Class="HiveCreatureFramework.CompPropertiesHiveResource">
        <resources>
          <FH_Resource_HostileNutrition>200</FH_Resource_HostileNutrition>
        </resources>
        <tags>
          <li>Flesh</li>
        </tags>
        <compClass>FleshHive.CompHiveResource_HostileFleshHive</compClass>
      </li>
      <li Class="HiveCreatureFramework.CompPropertiesHiveSpawner">
        <UnitCategories>
          <li>FH_Category_HostileFleshBeasts</li>
        </UnitCategories>
      </li>
      <li>
        <compClass>HiveCreatureFramework.CompProgressHolder</compClass>
      </li>
      <li Class="HiveCreatureFramework.CompPropertiesHiveContainer">
        <tags>
          <li>Flesh</li>
        </tags>
        <resource>FH_Resource_HostileNutrition</resource>
        <healResource>FH_Resource_HostileNutrition</healResource>
        <maintenancePerResource>1</maintenancePerResource>
        <maintenancePerInterval>0.02</maintenancePerInterval>
        <healPointPerInterval>1</healPointPerInterval>
        <healPointPerResource>5</healPointPerResource>
        <interval>250</interval>
        <canRecycleUnit>false</canRecycleUnit>
        <compClass>FleshHive.CompHiveContainer_HostileFleshHive</compClass>
      </li>
      <li Class="FleshHive.CompProperties_FleshSpread">
        <intervalDays>0.5</intervalDays>
        <radius>10.5</radius>
        <cellsPerErosion>12</cellsPerErosion>
        <initialErosionCount>10</initialErosionCount>
      </li>
      <li Class="FleshHive.CompProperties_FleshmassBase">
        <size>(3,2)</size>
      </li>
      <li>
        <compClass>FleshHive.CompHostileHiveIncome</compClass>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_InvalidOverSubstructure</li>
    </placeWorkers>
  </ThingDef>
</Defs>