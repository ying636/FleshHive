  <ThingDef ParentName="BuildingNaturalBase">
    <defName>FH_FleshSack</defName>
    <label>flesh sack</label>
    <description>A swollen sack of flesh. These immobile flesh beasts serve as digestive organs. Place living creatures inside to continuously supply the hive with nutrition. They cannot digest inorganic matter, and when digestion is complete they will eject desiccated remains.</description>
    <thingClass>FleshHive.FleshSack</thingClass>
