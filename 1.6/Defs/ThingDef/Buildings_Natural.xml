  <ThingDef ParentName="BuildingBase">
    <defName>FH_FleshParasiteVat</defName>
    <label>flesh parasite vat</label>
    <description>A flesh device made from sharp bone-spike tentacles and clotted flesh. It gradually devours fleshbeast cells and implants them into a host, allowing the fleshbeast to survive independently inside the host's body. The parasite strengthens its host and can actively attack the host's enemies, but its nutrition must be supplied by the host, causing the host to become hungry more easily.</description>
    <thingClass>FleshHive.FleshParasitePod</thingClass>
    <graphicData>
      <texPath>Things/Building/FH_FleshParasiteVat/FH_FleshParasiteVat</texPath>
