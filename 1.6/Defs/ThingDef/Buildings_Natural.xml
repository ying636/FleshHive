  <ThingDef ParentName="BuildingBase">
    <defName>FH_FleshDoor</defName>
    <label>flesh door</label>
    <description>A door grown from twisted flesh. It writhes open for approaching creatures and seals the passage behind them.</description>
    <thingClass>Building_Door</thingClass>
    <graphicData>
      <texPath>Things/Building/FH_FleshDoor/FH_FleshDoor_Mover</texPath>
