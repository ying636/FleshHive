    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <fillPercent>0.5</fillPercent>
    <inspectorTabs>
      <li>HiveCreatureFramework.ITab_Hive</li>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <statBases>
      <MaxHitPoints>130</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <HCF_Stat_HiveCapacity>50</HCF_Stat_HiveCapacity>
    </statBases>
    <pathCost>42</pathCost>
    <receivesSignals>true</receivesSignals>
    <blockWind>true</blockWind>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <killedLeavings>
      <InsectJelly>30</InsectJelly>
    </killedLeavings>
    <costList>
      <InsectJelly>50</InsectJelly>
    </costList>
    <designationCategory>FH_Flesh</designationCategory>
    <building>
      <storageGroupTag>Hive</storageGroupTag>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <categories>
            <li>Root</li>
          </categories>
          <disallowedCategories>
            <li>Chunks</li>
            <li>Plants</li>
            <li>Buildings</li>
            <li>CorpsesMechanoid</li>
          </disallowedCategories>
          <specialFiltersToDisallow>
            <li>AllowRotten</li>
          </specialFiltersToDisallow>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Preferred</priority>
        <filter>
          <categories>
            <li>Foods</li>
            <li>Manufactured</li>
            <li>ResourcesRaw</li>
            <li>Items</li>
            <li>Weapons</li>
            <li>Apparel</li>
            <li>BodyParts</li>
            <li>Corpses</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <comps>
      <li Class="HiveCreatureFramework.CompPropertiesHiveFormulaSpawner" />
      <li Class="HiveCreatureFramework.CompPropertiesHiveResource">
        <resources>
          <FH_Resource_Nutrition>0</FH_Resource_Nutrition>
        </resources>
        <tags>
          <li>Flesh</li>
          <li>FleshHive</li>
        </tags>
      </li>
      <li Class="HiveCreatureFramework.CompPropertiesHiveSpawner">
        <UnitCategories>
          <li>FH_Category_LittleFleshBeast</li>
          <li>FH_Category_MeldBeast</li>
        </UnitCategories>
      </li>
      <li Class="HiveCreatureFramework.CompPropertiesHiveGroup">
        <groupCount>1</groupCount>
        <specialWorks>
          <li>HCF_UnitWork_Hunt</li>
        </specialWorks>
        <tags>
          <li>Flesh</li>
        </tags>
      </li>
      <li Class="FleshHive.CompProperties_FleshSpread">
        <intervalDays>3</intervalDays>
        <radius>10.5</radius>
        <cellsPerErosion>3</cellsPerErosion>
        <initialErosionCount>10</initialErosionCount>
      </li>
      <li Class="HiveCreatureFramework.CompPropertiesUnitFuser">
        <defaultFusion>FH_Fusion_Default</defaultFusion>
        <category>LittleFlesh</category>
      </li>
      <li Class="HiveCreatureFramework.CompPropertiesHiveUpgrader">
        <upgrades>
        </upgrades>
      </li>
      <li Class="HiveCreatureFramework.CompPropertiesHiveEvolution">
        <map>FH_EvolutionMap_FleshHive</map>
      </li>
      <li>
        <compClass>HiveCreatureFramework.CompProgressHolder</compClass>
      </li>
      <li Class="HiveCreatureFramework.CompPropertiesHiveContainer">
        <resource>FH_Resource_Nutrition</resource>
        <healResource>FH_Resource_Nutrition</healResource>
        <tags>
          <li>Flesh</li>
          <li>FleshHive</li>
        </tags>
      </li>
      <li Class="FleshHive.CompProperties_FleshmassBase">
        <size>2</size>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingNaturalBase">
