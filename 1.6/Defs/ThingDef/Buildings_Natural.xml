      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Preferred</priority>
        <filter>
          <categories>
            <li>Foods</li>
            <li>Manufactured</li>
            <li>ResourcesRaw</li>
            <li>Items</li>
            <li>Weapons</li>
            <li>Apparel</li>
            <li>BodyParts</li>
            <li>Corpses</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <comps>
      <li Class="HiveCreatureFramework.CompPropertiesHiveFormulaSpawner" />
      <li Class="HiveCreatureFramework.CompPropertiesHiveResource">
        <transferOnEvolution>false</transferOnEvolution>
        <resources>
          <FH_Resource_Nutrition>0</FH_Resource_Nutrition>
        </resources>
        <tags>
          <li>Flesh</li>
          <li>FleshHive</li>
        </tags>
      </li>
      <li Class="HiveCreatureFramework.CompPropertiesHiveSpawner">
        <UnitCategories>
          <li>FH_Category_LittleFleshBeast</li>
          <li>FH_Category_MeldBeast</li>
        </UnitCategories>
      </li>
      <li Class="HiveCreatureFramework.CompPropertiesHiveGroup">
        <groupCount>1</groupCount>
        <specialWorks>
          <li>HCF_UnitWork_Hunt</li>
        </specialWorks>
        <tags>
          <li>Flesh</li>
        </tags>
      </li>
      <li Class="FleshHive.CompProperties_FleshSpread">
        <intervalDays>3</intervalDays>
        <radius>10.5</radius>
        <cellsPerErosion>3</cellsPerErosion>
        <initialErosionCount>10</initialErosionCount>
      </li>
      <li Class="FleshHive.CompProperties_HiveInitialNutrition">
        <initialNutrition>100</initialNutrition>
      </li>
      <li Class="HiveCreatureFramework.CompPropertiesUnitFuser">
        <defaultFusion>FH_Fusion_Default</defaultFusion>
        <category>LittleFlesh</category>
      </li>
      <li Class="HiveCreatureFramework.CompPropertiesHiveUpgrader">
