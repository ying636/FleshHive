      <drawSize>(3.5,2.5)</drawSize>
    </graphicData>
    <drawerType>RealtimeOnly</drawerType>
    <size>(3,2)</size>
    <uiIconScale>0.65</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <fillPercent>0.5</fillPercent>
    <inspectorTabs>
      <li>FleshHive.ITab_Parasitism</li>
    </inspectorTabs>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <pathCost>42</pathCost>
    <receivesSignals>true</receivesSignals>
    <blockWind>true</blockWind>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <killedLeavings>
      <InsectJelly>30</InsectJelly>
    </killedLeavings>
    <costList>
      <InsectJelly>50</InsectJelly>
    </costList>
    <designationCategory>HCF_Hive</designationCategory>
    <building>

    </building>
    <comps>
      <li Class="FleshHive.CompProperties_FleshmassBase">
        <outlineGraphic>
          <texPath>Things/Building/FH_FleshParasiteVat/FH_FleshParasiteVat_Outline</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(3.6,2.6)</drawSize>
        </outlineGraphic> 
      </li>
    </comps>
  </ThingDef>

</Defs>
