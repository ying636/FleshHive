    <description>TODO</description>
    <thingClass>HiveCreatureFramework.Building_Hive</thingClass>
    <graphicData>
      <texPath>Things/Building/FH_FleshHive/FH_FleshHive</texPath>
      <graphicClass>Graphic_Single</graphicClass>
