  <ThingDef ParentName="BodyPartBase">
    <defName>Tentacle</defName>
    <label>flesh tentacle</label>
    <description>A fleshy, muscled tentacle resembling a partial transformation into a fleshbeast. The tentacle is excellent at manipulation.\n\nThe flesh tentacle has its own neural structures and may become dangerous if removed.</description>
    <researchPrerequisites><li>FH_Research_FleshFusion</li></researchPrerequisites>
    <graphicData>
      <texPath>Things/Item/FH_FleshHealthItem</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.80</drawSize>
    </graphicData>
    <statBases>
      <Mass>1</Mass>
      <WorkToMake>26000</WorkToMake>
    </statBases>
    <thingCategories>
      <li>BodyPartsNatural</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="BodyPartBase">
    <defName>FH_FleshAdaptationModule</defName>
    <label>flesh adaptation module</label>
    <description>A tumor-like flesh module produced by the flesh hive. After implantation, it subtly reshapes the host's mind, removing disgust toward flesh creatures, flesh-made goods, and twisted meat, and allowing the host to live more easily alongside the flesh hive.</description>
    <researchPrerequisites><li>FH_Research_FleshbeastCoexistence</li></researchPrerequisites>
    <graphicData>
      <texPath>Things/Item/FH_FleshHealthItem</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.80</drawSize>
    </graphicData>
    <statBases>
      <Mass>1</Mass>
      <WorkToMake>26000</WorkToMake>
      <MarketValue>600</MarketValue>
    </statBases>
    <thingCategories>
      <li>BodyPartsNatural</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="SerumBase" MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>FH_FleshSymbiosisSerum</defName>
    <label>symbiosis serum</label>
    <description>A syringe filled with opaque, flesh-colored fluid that allows the user to become mentally attuned to flesh structures. Once injected into muscle, the serum alters the user's mind and spirit, removing disgust toward flesh creatures, flesh-made products, and even twisted meat, allowing them to live better alongside the flesh hive.</description>
    <researchPrerequisites><li>FH_Research_BasicFleshHive</li></researchPrerequisites>
    <graphicData>
      <texPath>Things/Item/Serum/SerumMetalblood</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <comps>
      <li Class="CompProperties_UseEffectAddHediff">
        <hediffDef>FH_FleshAdaptation</hediffDef>
        <allowRepeatedUse>false</allowRepeatedUse>
      </li>
      <li Class="CompProperties_UseEffectPlaySound">
        <soundOnUsed>MechSerumUsed</soundOnUsed>
      </li>
    </comps>
    <recipeMaker Inherit="False" IsNull="True" />
  </ThingDef>

  <ThingDef ParentName="BodyPartBase">
    <defName>FH_FleshSymbiosisModule</defName>
    <label>flesh symbiosis module</label>
    <description>A tumor-like module produced by the flesh hive. It allows the host to draw nutrition directly from the hive, making it easier to live alongside the flesh hive. However, having nutrition delivered straight into the body instead of eating can be irritating.</description>
    <researchPrerequisites><li>FH_Research_FleshbeastCoexistence</li></researchPrerequisites>
    <graphicData>
      <texPath>Things/Item/FH_FleshHealthItem</texPath>
      <graphicClass>Graphic_Single</graphicClass>
