<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>FH_NerveFlesh</defName>
    <label>nerve flesh</label>
    <description>An essential part of flesh nerves. Many complex flesh structures require nerve flesh to complete their construction.</description>
    <researchPrerequisites><li>FH_Research_ComplexFleshHive</li></researchPrerequisites>
    <graphicData>
      <texPath>Things/Item/FH_NerveFlesh</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Beauty>-4</Beauty>
      <DeteriorationRate>2</DeteriorationRate>
      <Mass>0.15</Mass>
      <Flammability>0.5</Flammability>
      <MarketValue>1.5</MarketValue>
    </statBases>
    <thingCategories Inherit="False">
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>FH_FleshCarapace</defName>
    <label>flesh carapace</label>
    <description>A carapace commonly found on fleshbeasts. It contains trace amounts of bioferrite that are difficult to extract, and is both hard and lightweight. It can be used as a building material.</description>
    <researchPrerequisites><li>FH_Research_FleshFurniture</li></researchPrerequisites>
    <graphicData>
      <texPath>Things/Item/FH_FleshCarapace</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MarketValue>0.95</MarketValue>
      <Mass>0.35</Mass>
      <StuffPower_Armor_Sharp>0.82</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.52</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.45</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>6</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>2</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>0.85</SharpDamageMultiplier>
      <BluntDamageMultiplier>0.9</BluntDamageMultiplier>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>false</burnableByRecipe>
    <stuffProps>
      <stuffAdjective>carapace</stuffAdjective>
      <categories>
        <li>Metallic</li>
      </categories>
      <appearance>Metal</appearance>
      <commonality>0</commonality>
      <allowedInStuffGeneration>false</allowedInStuffGeneration>
      <constructEffect>ConstructMetal</constructEffect>
      <color>(120, 86, 86)</color>
      <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Metal</soundImpactMelee>
      <statFactors>
        <MaxHitPoints>1.3</MaxHitPoints>
        <Beauty>0.65</Beauty>
        <Flammability>0.85</Flammability>
        <MeleeWeapon_CooldownMultiplier>1</MeleeWeapon_CooldownMultiplier>
        <DoorOpenSpeed>1.1</DoorOpenSpeed>
        <WorkToBuild>1.6</WorkToBuild>
        <WorkToMake>1.6</WorkToMake>
      </statFactors>
    </stuffProps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
  </ThingDef>

  <ThingDef ParentName="PlantFoodRawBase">
    <defName>FH_FleshBerry</defName>
    <label>fleshberry</label>
    <description>A red, fleshy fruit grown from a twisted flesh bush. It can be eaten raw, but its dense metallic taste lingers unpleasantly. The fruit is probably still alive; it does not rot.</description>
    <researchPrerequisites><li>FH_Research_NutritionCycle</li></researchPrerequisites>
    <graphicData>
      <texPath>Things/Plant/FH_FleshBush/FH_MeatBerries</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Beauty>-4</Beauty>
      <DeteriorationRate>6</DeteriorationRate>
      <Mass>0.027</Mass>
      <Flammability>0.5</Flammability>
      <Nutrition>0.25</Nutrition>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
      <MarketValue>1.2</MarketValue>
    </statBases>
    <ingestible>
      <preferability>RawTasty</preferability>
      <tasteThought/>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>RawMeat_Eat</ingestSound>
      <foodType>Meat</foodType>
      <specialThoughtDirect>FH_AteRawFleshberry</specialThoughtDirect>
      <specialThoughtAsIngredient>FH_AteCookedFleshberry</specialThoughtAsIngredient>
    </ingestible>
    <ingredient>
      <mergeCompatibilityTags>
        <li>Meat</li>
      </mergeCompatibilityTags>
    </ingredient>
    <thingCategories Inherit="False">
      <li>MeatRaw</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>FH_DreadmeldSeed</defName>
    <label>dreadmeld seed</label>
    <description>The fleshy core of a dreadmeld. It is a tumor-like lump made entirely of flesh, beating endlessly like a heart. A dreadmeld seed can be used to cultivate your own flesh hive or giant fleshbeast, or consumed by a dreadmeld to strengthen itself.</description>
    <graphicData>
      <texPath>Things/Item/FH_DreadmeldSeed</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>1</stackLimit>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Beauty>-10</Beauty>
      <DeteriorationRate>2</DeteriorationRate>
      <Mass>8</Mass>
      <Flammability>0.5</Flammability>
      <MarketValue>800</MarketValue>
    </statBases>
    <modExtensions>
      <li Class="FleshHive.ModExtension_MeldGrowth">
        <meld>FH_Dreadmeld</meld>
      </li>
    </modExtensions>
    <thingCategories Inherit="False">
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

