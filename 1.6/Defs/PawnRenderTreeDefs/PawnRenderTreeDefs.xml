  <PawnRenderTreeDef>
    <defName>FH_FleshReplica</defName>
    <root Class="PawnRenderNodeProperties_Parent">
      <debugLabel>Root</debugLabel>
      <tagDef>Root</tagDef>
      <children>
        <li>
          <debugLabel>Body</debugLabel>
          <nodeClass>FleshHive.PawnRenderNode_FleshReplicaBody</nodeClass>
