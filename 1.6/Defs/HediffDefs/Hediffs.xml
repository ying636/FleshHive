      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>FH_Parasitism_Paraspike</defName>
    <label>寄血兽寄生</label>
    <hediffClass>FleshHive.ParasitismHediff</hediffClass>
    <description>降低失血速率并免疫感染。被寄血兽寄生的生物，其后代也会继承这种寄生。</description>
    <isBad>false</isBad>
    <defaultLabelColor>(0.7, 0.1, 0.1)</defaultLabelColor>
