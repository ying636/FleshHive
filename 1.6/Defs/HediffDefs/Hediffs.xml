  <HediffDef>
    <defName>FH_Parasitism_Puffspike</defName>
    <label>puffspike parasitism</label>
    <hediffClass>FleshHive.ParasitismHediff</hediffClass>
    <description>This creature is parasitized by a puffspike. The fleshbeast grants it additional abilities, but also imposes significant costs.\n\nThe host is immune to asthma and lung rot, which are cured from its lungs. It moves faster and tolerates toxic environments better.</description>
    <isBad>false</isBad>
    <defaultLabelColor>(0.7, 0.1, 0.1)</defaultLabelColor>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <painFactor>1.06</painFactor>
        <statFactors>
          <MoveSpeed>1.1</MoveSpeed>
          <ToxicResistance>1.3</ToxicResistance>
        </statFactors>
        <makeImmuneTo>
          <li>Asthma</li>
          <li>LungRot</li>
        </makeImmuneTo>
      </li>
    </stages>
    <comps>
      <li Class="FleshHive.Effect.HediffCompProperties_Immunity">
        <hds>
          <li>Asthma</li>
          <li>LungRot</li>
        </hds>
      </li>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDef>FH_Parasitism_BoneSpikeShot</abilityDef>
      </li>
    </comps>
  </HediffDef>

