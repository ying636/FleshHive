<?xml version="1.0" encoding="utf-8"?>
<Defs>


  <HediffDef>
    <defName>FH_Spike_Paraspike</defName>
    <label>paraspike's spike</label>
    <hediffClass>FleshHive.Hediff_FH_Spike_Paraspike</hediffClass>
    <description>A paraspike's core bone spike, used to parasite a host and sustain its life. It remains embedded in the host, continuously regulating flesh and blood.</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.7, 0.1, 0.1)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500~5000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>FH_LostSpike_Paraspike</defName>
    <label>lost spike</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>The paraspike has lost the core bone spike it needs to survive. Unless it regenerates soon, it will weaken and die.</description>
    <defaultLabelColor>(0.7, 0.1, 0.1)</defaultLabelColor>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_DisappearsAndKills">
        <disappearsAfterTicks>5000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>FH_Parasitism_Fingerspike</defName>
    <label>fingerspike parasitism</label>
    <hediffClass>FleshHive.ParasitismHediff</hediffClass>
    <description>被独爪兽寄生后，宿主体表生长骨刺触手。</description>
    <isBad>false</isBad>
    <defaultLabelColor>(0.7, 0.1, 0.1)</defaultLabelColor>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statFactors>
          <WorkSpeedGlobal>1.1</WorkSpeedGlobal>
        </statFactors>
        <statOffsets>
          <SocialImpact>-1</SocialImpact>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="FleshHive.HediffCompProperties_Parasitism">
        <tentacles>
          <li>
            <tentacleClass>FleshHive.Tentacle_Attackable</tentacleClass>
            <damageDef>Stab</damageDef>
            <renderNode>
              <debugLabel>Tentacle</debugLabel>
              <workerClass>FleshHive.PawnNodeRenderWorker_Tentacle</workerClass>
              <texPath>Things/Pawn/Fleshbeast/Fingerspike/Attachments/Fingerspike_TopLimb</texPath>
              <baseLayer>100</baseLayer>
              <drawData>
                <dataSouth>
                  <layer>-120</layer>
                </dataSouth>
              </drawData>
            </renderNode>
          </li>
        </tentacles>
      </li>
      <li Class="HediffCompProperties_ThoughtSetter">
        <thought>FH_Thought_FleshParasitism</thought>
        <moodOffset>-6</moodOffset>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>FH_Parasitism_Puffspike</defName>
    <label>肺血兽寄生</label>
    <hediffClass>FleshHive.ParasitismHediff</hediffClass>
    <description>完全免疫哮喘与肺瘟，并治愈宿主肺中的这些疾病。移动速度提升且更耐受毒性环境。</description>
    <isBad>false</isBad>
    <defaultLabelColor>(0.7, 0.1, 0.1)</defaultLabelColor>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <painFactor>1.06</painFactor>
        <statFactors>
          <MoveSpeed>1.1</MoveSpeed>
          <ToxicResistance>1.3</ToxicResistance>
        </statFactors>
        <makeImmuneTo>
          <li>Asthma</li>
          <li>LungRot</li>
        </makeImmuneTo>
      </li>
    </stages>
    <comps>
      <li Class="FleshHive.Effect.HediffCompProperties_Immunity">
        <hds>
          <li>Asthma</li>
          <li>LungRot</li>
        </hds>
      </li>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDef>FH_Parasitism_BoneSpikeShot</abilityDef>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>FH_Parasitism_Gutspike</defName>
    <label>胃血兽寄生</label>
    <hediffClass>FleshHive.ParasitismHediff</hediffClass>
    <description>几乎不会食物中毒，并对肠道蠕虫具备免疫与清除能力。</description>
    <isBad>false</isBad>
    <defaultLabelColor>(0.7, 0.1, 0.1)</defaultLabelColor>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <painFactor>1.08</painFactor>
        <foodPoisoningChanceFactor>0</foodPoisoningChanceFactor>
        <makeImmuneTo>
          <li>GutWorms</li>
        </makeImmuneTo>
      </li>
    </stages>
    <comps>
      <li Class="FleshHive.Effect.HediffCompProperties_Immunity">
        <hds>
          <li>GutWorms</li>
        </hds>
      </li>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDef>FH_Acidbulb_Launch</abilityDef>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>FH_Parasitism_Whipspike</defName>
    <label>鞭爪兽寄生</label>
