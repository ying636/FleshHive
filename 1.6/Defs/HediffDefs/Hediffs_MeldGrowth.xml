<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>FH_MeldGrowth</defName>
    <label>mother beast growth</label>
    <description>The mother beast has consumed its corresponding core and undergone permanent growth. Each growth level increases parasitism capacity, twisted flesh capacity, body part health, regeneration, bleed resistance, and damage resistance.</description>
    <hediffClass>FleshHive.Hediff_MeldGrowth</hediffClass>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>5</maxSeverity>
    <isBad>false</isBad>
    <duplicationAllowed>false</duplicationAllowed>
    <defaultLabelColor>(0.85, 0.25, 0.30)</defaultLabelColor>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <totalBleedFactor>0.8</totalBleedFactor>
        <regeneration>50</regeneration>
        <statOffsets>
          <FH_Stat_ParasitismCapacity>1</FH_Stat_ParasitismCapacity>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.85</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <totalBleedFactor>0.6</totalBleedFactor>
        <regeneration>100</regeneration>
        <statOffsets>
          <FH_Stat_ParasitismCapacity>2</FH_Stat_ParasitismCapacity>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.7</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <totalBleedFactor>0.4</totalBleedFactor>
        <regeneration>150</regeneration>
        <statOffsets>
          <FH_Stat_ParasitismCapacity>3</FH_Stat_ParasitismCapacity>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.55</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <totalBleedFactor>0.2</totalBleedFactor>
        <regeneration>200</regeneration>
        <statOffsets>
          <FH_Stat_ParasitismCapacity>4</FH_Stat_ParasitismCapacity>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.4</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>5</minSeverity>
        <totalBleedFactor>0.1</totalBleedFactor>
        <regeneration>250</regeneration>
        <statOffsets>
          <FH_Stat_ParasitismCapacity>5</FH_Stat_ParasitismCapacity>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.25</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
