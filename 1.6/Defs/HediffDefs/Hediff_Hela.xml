<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>FH_Hela</defName>
    <label>Hela</label>
    <hediffClass>FleshHive.Hediff_Hela</hediffClass>
    <description>Hela's body has become a living command node for fleshbeasts. She can control a large fleshbeast group and automatically sustain its members with twisted flesh. Occupied parasite space reinforces every part of her body.</description>
    <isBad>false</isBad>
    <defaultLabelColor>(0.75, 0.15, 0.15)</defaultLabelColor>
    <comps>
      <li Class="FleshHive.HediffCompProperties_HelaNode">
        <groupCount>1</groupCount>
        <groupType>FleshHive.UnitGroup_FleshNode</groupType>
        <tags>
          <li>Flesh</li>
        </tags>
        <defaultUnitLimit>50</defaultUnitLimit>
        <groupCheckIntervalTicks>60</groupCheckIntervalTicks>
        <maintenanceIntervalTicks>2500</maintenanceIntervalTicks>
        <maintenancePerInterval>0.1</maintenancePerInterval>
        <maintenancePerTwistedFlesh>1</maintenancePerTwistedFlesh>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>FH_HelaShardComa</defName>
    <label>dark archotech adaptation coma</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>Hela is unconscious while her body adapts to a dark archotech shard and grows new parasite space.</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.9, 1.0, 0.35)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
        <canUseDecimalsShortForm>true</canUseDecimalsShortForm>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
