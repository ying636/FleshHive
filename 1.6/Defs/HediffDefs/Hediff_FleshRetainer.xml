<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>FH_FleshRetainer</defName>
    <label>flesh retainer</label>
    <hediffClass>FleshHive.Hediff_FleshRetainer</hediffClass>
    <description>A weakened version of Hela's power. Parasitism does not increase body factor, and the host is not a node creature. Parasite capacity starts at 4. Consuming shards can increase it to 10, causing a one-day coma each time.</description>
    <isBad>false</isBad>
    <defaultLabelColor>(0.75, 0.15, 0.15)</defaultLabelColor>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>FH_FleshRetainerShardComa</defName>
    <label>shard adaptation coma</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>The flesh retainer is unconscious while adapting to a dark archotech shard and growing new parasite space.</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.9, 1.0, 0.35)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
        <canUseDecimalsShortForm>true</canUseDecimalsShortForm>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
