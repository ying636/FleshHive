  <AbilityDef>
    <defName>FH_SpikeLaunch_Paraspike</defName>
    <label>spike launch</label>
    <description>Launch a bone spike at a target.</description>
    <cooldownTicksRange>5</cooldownTicksRange>
    <abilityClass>FleshHive.Ability_SpikeLaunch_Paraspike</abilityClass>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <soundCast>Ability_SpineLaunch</soundCast>
      <ai_IsWeapon>false</ai_IsWeapon>
      <verbClass>HiveCreatureFramework.Verb_AbilityShootWithEffects</verbClass>
      <range>36.9</range>
      <defaultProjectile>FH_Spike_Paraspike</defaultProjectile>
      <defaultCooldownTime>0.5</defaultCooldownTime>
    </verbProperties>
    <comps>
      <li Class="HiveCreatureFramework.CompPropertiesAbilityEffect_GiveHediff_Unit">
        <durationSecondsOverride>50</durationSecondsOverride>
        <hediffDef>FH_LostSpike_Paraspike</hediffDef>
        <onlyApplyToSelf>True</onlyApplyToSelf>
        <applyToSelf>True</applyToSelf>
        <severity>1</severity>
      </li>
    </comps>
