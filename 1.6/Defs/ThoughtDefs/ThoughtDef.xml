<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThoughtDef>
        <defName>FH_Thought_FleshParasitism</defName>
        <thoughtClass>FleshHive.Thought_Memory_FleshAdapted</thoughtClass>
        <label>flesh parasitism</label>
        <stages>
            <li>
                <label>flesh parasitism</label>
                <description>Living flesh resides within the body.</description>
                <baseMoodEffect>0</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>FH_AteRawFleshberry</defName>
        <thoughtClass>FleshHive.Thought_FoodEaten_FleshAdapted</thoughtClass>
        <durationDays>1</durationDays>
        <showBubble>true</showBubble>
        <icon>Things/Mote/ThoughtSymbol/Food</icon>
        <stages>
            <li>
                <label>ate raw fleshberries</label>
                <description>The fleshberries were sweet, but eating them raw left a disturbing taste of living meat.</description>
                <baseMoodEffect>-3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>FH_AteCookedFleshberry</defName>
        <thoughtClass>FleshHive.Thought_FoodEaten_FleshAdapted</thoughtClass>
        <durationDays>1</durationDays>
        <showBubble>true</showBubble>
        <icon>Things/Mote/ThoughtSymbol/Food</icon>
        <stages>
            <li>
                <label>ate cooked fleshberries</label>
                <description>The fleshberries were cooked, but the meal still carried a faint fleshy aftertaste.</description>
                <baseMoodEffect>-1</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>FH_Thought_FleshNutrition</defName>
        <durationDays>0.25</durationDays>
        <showBubble>true</showBubble>
        <icon>Things/Mote/ThoughtSymbol/Food</icon>
        <stages>
            <li>
                <label>flesh nutrition</label>
                <description>I drew nutrition directly from the flesh hive. It did not feel good.</description>
                <baseMoodEffect>-5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>
</Defs>
