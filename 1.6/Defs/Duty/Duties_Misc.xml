<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  <DutyDef>
    <defName>FH_Defend_Gutspike</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="JobGiver_AIAbilityFight">
          <targetAcquireRadius>48</targetAcquireRadius>
          <targetKeepRadius>36</targetKeepRadius>
          <ability>CorrosiveSpray</ability>
        </li>
        <li Class="JobGiver_AIDefendPoint">
          <targetAcquireRadius>36</targetAcquireRadius>
          <targetKeepRadius>24</targetKeepRadius>
        </li>
        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>16</maxDistToSquadFlag>
        </li>
        <li Class="JobGiver_WanderNearDutyLocation">
          <wanderRadius>8</wanderRadius>
          <locomotionUrgencyOutsideRadius>Sprint</locomotionUrgencyOutsideRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>FH_HuntEnemies_Gutspike</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
