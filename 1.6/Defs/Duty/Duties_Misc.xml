          <ability>CorrosiveSpray</ability>
        </li>
        <li Class="JobGiver_AIFightEnemies">
          <targetAcquireRadius>36</targetAcquireRadius>
          <targetKeepRadius>24</targetKeepRadius>
          <allowTurrets>true</allowTurrets>
        </li>
        <li Class="JobGiver_AIGotoNearestHostile" />
      </subNodes>
    </thinkNode>
  </DutyDef>

